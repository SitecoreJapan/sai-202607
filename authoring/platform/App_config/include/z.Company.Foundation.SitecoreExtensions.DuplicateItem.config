<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
  <sitecore>
    <processors>
      <uiDuplicateItem>
        <!--
          Replace only SXA's GetName processor. CheckSubitems and Execute remain unchanged.
          If showconfig.aspx reports a different assembly-qualified original type,
          update the @type value in the patch:instead predicate accordingly.
        -->
        <processor
          type="Support.Foundation.SitecoreExtensions.Pipelines.DuplicateItem.DuplicateItem, Support.DuplicateItem"
          method="GetName"
          patch:instead="processor[@method='GetName' and @type='Sitecore.XA.Foundation.ContentValidation.Pipelines.DuplicateItem.DuplicateItem, Sitecore.XA.Foundation.ContentValidation']" />
      </uiDuplicateItem>
    </processors>
  </sitecore>
</configuration>
